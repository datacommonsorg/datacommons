Node: foo:FooGroup
typeOf: dcid:StatVarGroup
name: "Foo Demographics"
specializationOf: dcid:dc/g/Root

Node: foo:FooMultiEntityProvenance
typeOf: dcid:Provenance
name: "Foo Multi-Entity Dataset"
source: dcid:dc/s/FooOrganization
url: "https://foo.example.org/demographics"

# (a) Local Dimension Property & Local Enums ('foo:' namespace)
Node: foo:SectorEnum
typeOf: dcid:Class
name: "SectorEnum"
subClassOf: dcid:Enumeration

Node: foo:sector
typeOf: dcid:Property
name: "sector"
domainIncludes: dcid:Observation
rangeIncludes: foo:SectorEnum

Node: foo:TechSector
typeOf: foo:SectorEnum
name: "Technology Sector"

Node: foo:HealthcareSector
typeOf: foo:SectorEnum
name: "Healthcare Sector"

# (b) Multi-Entity Statistical Variable combining 'foo:' and 'dcid:' dimensions
Node: foo:EmployedAdultsBySexAndSector
typeOf: dcid:StatisticalVariable
name: "Employed adults by sex and sector"
populationType: dcid:Person
measuredProperty: dcid:count
statType: dcid:measuredValue
observationProperties: dcid:sex, foo:sector
memberOf: foo:FooGroup
